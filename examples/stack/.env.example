# Copie para .env:  cp .env.example .env   (valores de LABORATÓRIO — troque antes de expor qualquer coisa)
CLICKHOUSE_VERSION=26.10.9.12
CLICKSTACK_VERSION=2.46.0
MONGO_VERSION=5.0.32-focal
OTELCOL_VERSION=0.165.0
GRAFANA_VERSION=13.2.6
GRAFANA_CLICKHOUSE_PLUGIN_VERSION=4.23.5
TELEMETRYGEN_VERSION=v0.165.0
MCP_CLICKHOUSE_VERSION=0.7.0
CLICKHOUSE_JAEGER_VERSION=dev

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# gere com: openssl rand -hex 24
CLICKHOUSE_MCP_AUTH_TOKEN=change-me

# usuário somente leitura do ClickHouse Jaeger (criado por clickhouse/initdb/02-jaeger-reader.sql)
JAEGER_CH_USER=jaeger_reader
JAEGER_CH_PASSWORD=jaeger_reader
